{
  "name": "kavo-sys",
  "version": "1.0.0",
  "description": "KAVO-SYS Offline Restaurant POS",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev":              "vite",
    "build":            "vite build",
    "preview":          "vite preview",
    "electron:dev":     "NODE_ENV=development electron --dev .",
    "electron:build":   "npm run build && electron-builder",
    "electron:win":     "npm run build && electron-builder --win",
    "electron:mac":     "npm run build && electron-builder --mac",
    "electron:linux":   "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "dexie":     "^4.4.2",
    "react":     "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react":           "^18.3.1",
    "@types/react-dom":       "^18.3.1",
    "@vitejs/plugin-react":   "^4.3.1",
    "electron":               "^42.3.0",
    "electron-builder":       "^26.8.1",
    "electron-reload":        "^2.0.0-alpha.1",
    "vite":                   "^5.4.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId":       "com.kavosys.pos",
    "productName": "KAVO-SYS POS",
    "copyright":   "Copyright © 2025 KAVO-SYS",

    "directories": {
      "buildResources": "electron/assets",
      "output":         "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "electron/assets", "to": "assets" }
    ],

    "win": {
      "target":          [{ "target": "nsis", "arch": ["x64"] }],
      "icon":            "electron/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick":            false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName":        "KAVO-SYS POS",
      "installerIcon":       "electron/assets/icon.ico",
      "uninstallerIcon":     "electron/assets/icon.ico",
      "installerHeaderIcon": "electron/assets/icon.ico"
    },
    "mac": {
      "target":   [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon":     "electron/assets/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon":   "electron/assets/icon.png",
      "category": "Office"
    }
  }
}
